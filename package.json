{
  "name": "mature-feminine-site",
  "private": true,
  "version": "1.0.0",
  "description": "The Mature Feminine: static site (11ty) for GitHub Pages",
  "scripts": {
    "test": "node --test",
    "dev": "eleventy --serve",
    "build": "npm run content:check && node scripts/clean_site_output.js && eleventy",
    "content:sync": "node scripts/sync_archetypes.js",
    "content:check": "npm test && node scripts/validate_content.js",
    "content:publish-check": "npm test && node scripts/validate_content.js --publish",
    "book:check": "python3 book/print-pdf/generate_book.py --check",
    "book:build": "python3 book/print-pdf/generate_book.py",
    "download:shadows": "node scripts/download_shadows.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "markdown-it": "^13.0.2"
  }
}

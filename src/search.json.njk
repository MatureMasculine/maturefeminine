---
permalink: "/search.json"
---
{
  "items": [
{% set sep = "" %}
{% for group in collections.groups %}
      {{ sep }}{
        "type": "lifecycle",
        "lifecycle": {{ group.name | dump | safe }},
        "lifecycleSlug": {{ group.slug | dump | safe }},
        "name": {{ group.name | dump | safe }},
        "slug": {{ group.slug | dump | safe }},
        "group": {{ group.name | dump | safe }},
        "qualities": [],
        "balanceQualities": [],
        "keyQualities": {{ (group.essence or group.summary) | dump | safe }},
        "href": {{ group.url | dump | safe }}
      }
{% set sep = "," %}
{% endfor %}
{% for entry in collections.archetypes %}
      {{ sep }}{
        "type": "archetype",
        "lifecycle": {{ entry.lifecycleName | dump | safe }},
        "lifecycleSlug": {{ entry.lifecycle | dump | safe }},
        "name": {{ entry.name | dump | safe }},
        "slug": {{ entry.slug | dump | safe }},
        "group": {{ entry.lifecycleName | dump | safe }},
        "qualities": {{ entry.qualities | dump | safe }},
        "balanceQualities": {{ entry.qualities | dump | safe }},
        "keyQualities": {{ entry.profile.keyQualities | dump | safe }},
        "href": {{ entry.url | dump | safe }}
      }
{% set sep = "," %}
{% endfor %}
{% for entry in collections.shadows %}
      {{ sep }}{
        "type": "shadow",
        "lifecycle": {{ entry.lifecycleName | dump | safe }},
        "lifecycleSlug": {{ entry.lifecycle | dump | safe }},
        "name": {{ entry.name | dump | safe }},
        "slug": {{ entry.slug | dump | safe }},
        "parent": {{ entry.parentName | dump | safe }},
        "parentSlug": {{ entry.parent | dump | safe }},
        "group": {{ entry.lifecycleName | dump | safe }},
        "qualities": {{ entry.qualities | dump | safe }},
        "balanceQualities": {{ entry.qualities | dump | safe }},
        "keyQualities": {{ entry.profile.keyQualities | dump | safe }},
        "href": {{ entry.url | dump | safe }}
      }
{% set sep = "," %}
{% endfor %}
  ]
}

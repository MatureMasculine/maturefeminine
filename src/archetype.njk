---
layout: layout.njk
pagination:
  data: collections.archetypes
  size: 1
  alias: entry
permalink: "{{ entry.url }}index.html"
eleventyComputed:
  title: "{{ entry.name }} | The Mature Feminine"
---

<a class="small" href="{{ ('/' ~ entry.lifecycle ~ '/') | url }}">← Back to {{ entry.lifecycleName }}</a>
<header class="entry-header mt-2 mb-4">
  <p class="entry-kicker">{{ entry.lifecycleName }} archetype</p>
  <h1>{{ entry.name }}</h1>
</header>

{% if entry.quotes.opening %}
<blockquote class="entry-quote entry-quote-opening">{{ entry.quotes.opening | fixEncoding | stripOuterQuotes }}</blockquote>
{% endif %}

{% if entry.image %}
<figure class="entry-image">
  <img class="img-fluid rounded" src="{{ ('/' ~ entry.image) | url }}" alt="{{ entry.name }} illustration" loading="lazy">
  <figcaption class="small text-muted mt-1">{{ entry.name }}</figcaption>
</figure>
{% endif %}

<section class="profile-card mb-4" aria-labelledby="profile-heading">
  <h2 class="h4" id="profile-heading">Profile</h2>
  <dl class="profile-grid mb-0">
    <div data-profile-field="lifecycleStage"><dt>Lifecycle stage</dt><dd>{{ entry.profile.lifecycleStage }}</dd></div>
    <div data-profile-field="coreFunction"><dt>Core function</dt><dd>{{ entry.profile.coreFunction }}</dd></div>
    <div data-profile-field="balancedQualities"><dt>Balanced qualities</dt><dd>{{ entry.profile.balancedQualities }}</dd></div>
    <div data-profile-field="activeShadow"><dt>Active shadow</dt><dd><a href="{{ entry.activeShadow.url | url }}">{{ entry.profile.activeShadow }}</a></dd></div>
    <div data-profile-field="passiveShadow"><dt>Passive shadow</dt><dd><a href="{{ entry.passiveShadow.url | url }}">{{ entry.profile.passiveShadow }}</a></dd></div>
    {% if entry.profile.mythicResonances %}<div data-profile-field="mythicResonances"><dt>Mythic resonances</dt><dd>{{ entry.profile.mythicResonances }}</dd></div>{% endif %}
    <div data-profile-field="keyQualities"><dt>Key qualities</dt><dd>{{ entry.profile.keyQualities }}</dd></div>
  </dl>
</section>

<section class="shadow-links mb-4" aria-labelledby="shadows-heading">
  <h2 class="h4" id="shadows-heading">Shadow expressions</h2>
  <div class="row g-3">
    {% for shadow in entry.shadows %}
    <div class="col-12 col-md-6">
      <a class="shadow-link-card" href="{{ shadow.url | url }}">
        <span class="entry-kicker">{{ shadow.type }} shadow</span>
        <strong>{{ shadow.name }}</strong>
        <span>{{ shadow.profile.coreFunction }}</span>
      </a>
    </div>
    {% endfor %}
  </div>
</section>

{{ entry.bodySections | renderSections | safe }}

{% if entry.quotes.closing %}
<blockquote class="entry-quote entry-quote-closing">{{ entry.quotes.closing | fixEncoding | stripOuterQuotes }}</blockquote>
{% endif %}

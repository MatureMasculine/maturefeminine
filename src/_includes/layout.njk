<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or "The Mature Feminine" }}</title>
    <base href="{{ '/' | url }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="assets/styles.css" rel="stylesheet" />
    <link rel="icon" href="assets/favicon.ico" type="image/x-icon" />
{% if site.ga4 %}
    <!-- GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga4 }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '{{ site.ga4 }}');
    </script>
{% endif %}
  </head>
  <body>
    <div class="d-flex">
      <!-- Sidebar -->
      <nav id="sidebar" class="border-end p-3 offcanvas-lg offcanvas-start" tabindex="-1">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <a href="{{ '/' | url }}" class="navbar-brand fw-bold">Mature Feminine</a>
        </div>
        <div class="mb-2">
          <label class="visually-hidden" for="searchInput">Search the field guide</label>
          <input class="form-control form-control-sm" id="searchInput" type="search" placeholder="Search…" />
        </div>
        <div class="accordion" id="navAccordion">
{% for group in collections.groups %}
          <div class="accordion-item">
            <h2 class="accordion-header" id="heading-{{ group.slug }}">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{ group.slug }}" aria-expanded="false" aria-controls="collapse-{{ group.slug }}">
                {{ group.name }}
              </button>
            </h2>
            <div id="collapse-{{ group.slug }}" class="accordion-collapse collapse" data-bs-parent="#navAccordion">
              <div class="accordion-body py-2">
                <ul class="list-unstyled small" data-group="{{ group.slug }}">
                  <li class="mb-2 nav-item nav-lifecycle" data-name="{{ group.name | lower }}" data-qualities="{{ (group.summary ~ ' ' ~ group.essence) | lower }}">
                    <a class="text-decoration-none fw-semibold" href="{{ group.url | url }}">{{ group.name }} overview</a>
                  </li>
{% for entry in group.archetypes %}
                  <li class="mb-2 nav-item" data-name="{{ entry.name | lower }}" data-qualities="{{ ((entry.qualities | join(',')) ~ ' ' ~ entry.profile.keyQualities) | lower }}">
                    <a class="text-decoration-none" href="{{ entry.url | url }}">{{ entry.name }}</a>
                    <ul class="list-unstyled ms-3 mt-1">
{% for shadow in entry.shadows %}
                        <li class="nav-item nav-shadow" data-name="{{ shadow.name | lower }}" data-qualities="{{ ((shadow.qualities | join(',')) ~ ' ' ~ shadow.profile.keyQualities ~ ' ' ~ entry.name) | lower }}">
                          <a class="text-decoration-none small" href="{{ shadow.url | url }}">{{ shadow.name }}</a>
                        </li>
{% endfor %}
                    </ul>
                  </li>
{% endfor %}
                </ul>
              </div>
            </div>
          </div>
{% endfor %}
        </div>
      </nav>

      <!-- Content -->
      <main class="flex-grow-1">
        <div class="container py-4">
{{ content | safe }}
        </div>
      </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@6.6.2"></script>
    <script>
      (function () {
        const shadowRedirectsByPath = {{ shadowAnchorRedirectsByPath | dump | safe }};
        const shadowRedirects = shadowRedirectsByPath[window.location.pathname] || {};
        const target = shadowRedirects[window.location.hash];
        if (target) window.location.replace(target);
      }());
    </script>
    <script src="assets/main.js"></script>
  </body>
</html>
